import {readAdditionalResearch} from '../services/news/additional-research.ts';import {readFile,writeFile} from 'node:fs/promises';import {createHash} from 'node:crypto';import path from 'node:path';type LogEntry={url:string;startedAt:string;status?:number;ms?:number;bytes?:number;sha256?:string;snapshot?:string;error?:string};const dir=path.resolve('node_modules/.cache/news09-live-2'),orig=fetch,log:LogEntry[]=[];globalThis.fetch=async(input,init)=>{const url=String(input);if(url.includes('stats.gov.cn'))return new Response('',{status:503});if(url==='https://www.pwccn.com/zh/industries/retail-and-consumer.html')return new Response(await readFile(path.join(dir,'2.bin')),{headers:{'content-type':'text/html'}});if(url.includes('voice-of-consumers-china-report-dec2025.html'))return new Response(await readFile(path.join(dir,'8.bin')),{headers:{'content-type':'text/html'}});if(!url.endsWith('/voice-of-consumers-china-report-dec2025.pdf'))return new Response('',{status:503});const t=Date.now(),entry:LogEntry={url,startedAt:new Date().toISOString()};log.push(entry);try{const r=await orig(input,init);entry.status=r.status;entry.ms=Date.now()-t;const b=Buffer.from(await r.arrayBuffer());entry.bytes=b.length;entry.sha256=createHash('sha256').update(b).digest('hex');await writeFile(path.join(dir,'pdf-extra.bin'),b);return new Response(b,{status:r.status,headers:r.headers})}catch(e){entry.ms=Date.now()-t;entry.error=String(e);await writeFile(path.join(dir,'pdf-extra-log.json'),JSON.stringify(log,null,2));throw e}};const result=await readAdditionalResearch(new Date());await writeFile(path.join(dir,'pdf-extra-log.json'),JSON.stringify({log,result},null,2));console.log(JSON.stringify({log,sources:result.sources,items:result.items.map(({title,publishedAt,url,research})=>({title,publishedAt,url,research}))},null,2));
