{
  "name": "fmcg-ai-pm-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,green \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:proxy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_with_proxy.ps1",
    "dev:api": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --import tsx --import ./tests/support/css-stub.mjs --test tests/*.test.ts tests/*.test.tsx"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
