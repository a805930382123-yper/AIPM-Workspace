import {readAdditionalResearch} from '../../services/news/additional-research.ts';import {mkdir,mkdtemp,writeFile,appendFile} from 'node:fs/promises';import {createHash} from 'node:crypto';import path from 'node:path';const parent=path.resolve('node_modules/.cache');await mkdir(parent,{recursive:true});const dir=await mkdtemp(path.join(parent,'news09-fix-live-'));const log=async x=>appendFile(path.join(dir,'events.jsonl'),JSON.stringify(x)+'\n');const orig=fetch,pending=[];let id=0;globalThis.fetch=async(input,init)=>{const url=String(input);if(url.includes('stats.gov.cn'))return new Response('',{status:503});const n=++id,t=Date.now();await log({id:n,url,event:'start',at:new Date().toISOString()});try{const r=await orig(input,init);await log({id:n,event:'headers',status:r.status,ms:Date.now()-t});pending.push((async()=>{const reader=r.clone().body.getReader(),parts=[];let size=0;for(;;){const v=await reader.read();if(v.done)break;size+=v.value.length;if(size>10*1024*1024){await reader.cancel();throw Error('snapshot limit')};parts.push(v.value)}const bytes=Buffer.concat(parts);await writeFile(path.join(dir,n+'.bin'),bytes);await log({id:n,event:'complete',bytes:size,sha256:createHash('sha256').update(bytes).digest('hex'),ms:Date.now()-t})})().catch(async e=>{await log({id:n,event:'snapshot-error',error:String(e),ms:Date.now()-t})}));return r}catch(e){await log({id:n,event:'fetch-error',error:String(e),ms:Date.now()-t});throw e}};try{const result=await readAdditionalResearch(new Date(),undefined,true);await Promise.all(pending);await writeFile(path.join(dir,'result.json'),JSON.stringify(result,null,2));console.log(JSON.stringify({dir,sources:result.sources,items:result.items.map(({title,url,publishedAt,research})=>({title,url,publishedAt,research}))},null,2))}catch(e){await Promise.all(pending);await log({event:'fatal',error:String(e)});console.log(JSON.stringify({dir,error:String(e)}));process.exitCode=1}
