{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "app",
    "server",
    "tests",
    "scripts/smoke-sqlite.ts",
    "scripts/rebuild-search-index.ts",
    "scripts/bench-1000-pages.ts",
    "scripts/bench-vector-1000.ts",
    "scripts/run-retrieval-eval.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "tests/acceptance/kb02-storage-poc-20261020-case.mts",
    "tests/acceptance/KB02-FINAL-REPAIR-AUDIT-20261022-boundary.test.ts"
  ]
}
