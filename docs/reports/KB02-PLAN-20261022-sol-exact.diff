+import { storageFixture } from './support/kb02-storage-fixture.ts';
+import { storageHttp } from './support/kb02-storage-http.ts';
+
+const fixturePath='tests/acceptance/KB02-PLAN-20261022-sol-failure-fixture.json';
+const fixture=async()=>JSON.parse(await readFile(fixturePath,'utf8'));
+const sha=(s:string|Buffer)=>createHash('sha256').update(s).digest('hex');
+const chunks=(body:string)=>chunkText(body,{maxChunkChars:8000,overlap:400,maxRawChars:500000});
+const catalogs=(body:string)=>new Map(chunks(body).map(c=>[c.index,buildEvidenceLocatorCatalog(body,c)]));
+const data=(r:LlmCompletionRequest)=>JSON.parse(r.user.split('\n').at(-1)!);
+const validPlan=(p:ReturnType<typeof buildKnowledgePlanningInput>)=>({version:2,document:{title:'虚构主题',main_topic:'业务'},pages:[{title:'虚构主题',type:'metric',category:'metric',factIds:p.facts.map(i=>i.id),questionIds:p.questions.map(i=>i.id)}]});
+
+async function runFixture(source:{raw:any;checkpoint:ExtractionCheckpoint},response?:(r:LlmCompletionRequest)=>unknown,secrets:string[]=[]) {
+  const bundle=await loadExtractionRules('rules');
+  let cp=structuredClone({...source.checkpoint,rulesVersion:bundle.rulesVersion}),writes=0;
+  const requests:LlmCompletionRequest[]=[];
+  const provider:LlmProvider={name:'offline',model:'planning-context',secrets,complete:async r=>{requests.push(r);const output=response?response(r):validPlan(data(r));return {text:JSON.stringify(output),bytes:1,finishReason:'stop'};}};
+  const args={raw:source.raw,body:source.raw.body,bodySha256:sha(source.raw.body),rulesDir:'rules',provider,beforeCall:async(stage:'extracting'|'planning')=>{writes++;return cp={...cp,stage,attempts:cp.attempts+1};},saveCheckpoint:async(value:Omit<ExtractionCheckpoint,'integrity'>)=>{writes++;return cp=value as ExtractionCheckpoint;}};
+  return {args,requests,get cp(){return cp;},get writes(){return writes;},run:(planningRetry=false)=>runKnowledgePipeline({...args,checkpoint:cp,planningRetry})};
+}
+
+async function synthetic(body:string,pick:(text:string)=>boolean=()=>true) {
+  const raw={id:randomUUID(),title:'虚构规划测试',sourceType:'report',sourceName:'隔离',tags:[],body,bodySha256:sha(body)};
+  const completedChunks:CheckpointChunk[]=chunks(body).map(c=>{
+    const catalog=buildEvidenceLocatorCatalog(body,c),chosen=buildKnowledgeAtoms(body,catalog).filter(a=>a.text.trim()&&pick(a.text));
+    assert(chosen.length<=32);
+    const facts=chosen.map((a,i)=>({id:`f-c${c.index+1}-${i+1}`,text:a.text,atomId:a.id,chunkIndex:c.index,locatorIds:a.locatorIds,kind:a.fragment?'ambiguous' as const:'fact' as const}));
