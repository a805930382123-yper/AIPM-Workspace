# B04 产品 LLM Provider 配置示例（不含任何真实密钥，也不会被提交为 .env.local）。
# 用法：可在设置页保存到项目根目录 .env.local，或在启动服务端的终端里设置同名环境变量。
# 环境变量优先于该文件；任一主端地址、重档模型或 Key 由环境覆盖时设置页只读。Node 不会自动加载 .env。
# 仅服务端可用 FMCG_LLM_CONFIG_FILE 指定隔离配置文件；HTTP 请求不能更改此路径。
# 设置页只显示固定掩码与“是否已配置”，Key 不会进入前端、草稿、Wiki、日志或报告。
# 设置页保存到本地文件时，三个 FMCG_LLM_* 值使用 @fmcg-config-utf8-base64url-v1@ + UTF-8 Base64URL 编码；这是编码，不是加密。普通手工配置仍兼容。

# OpenAI-compatible Chat Completions 端点（通常以 /v1 结尾）
FMCG_LLM_BASE_URL=https://api.example.com/v1

# 模型名（按你的 Provider 文档填写）
FMCG_LLM_MODEL=example-model

# API Key（仅服务端使用）
FMCG_LLM_API_KEY=

# 可选主端配置。未填写轻档模型时，同端复用重档模型。
# FMCG_LLM_ENABLED=true
# FMCG_LLM_LABEL=主 Provider
# FMCG_LLM_LIGHT_MODEL=example-light-model
# FMCG_LLM_TIMEOUT_MS=45000

# 备用端需要显式启用并填写独立地址、Key 与重档模型。
# FMCG_LLM_BACKUP_ENABLED=false
# FMCG_LLM_BACKUP_LABEL=备用 Provider
# FMCG_LLM_BACKUP_BASE_URL=https://backup.example.com/v1
# FMCG_LLM_BACKUP_API_KEY=
# FMCG_LLM_BACKUP_MODEL=example-backup-model
# FMCG_LLM_BACKUP_LIGHT_MODEL=example-backup-light-model
# FMCG_LLM_BACKUP_TIMEOUT_MS=45000
