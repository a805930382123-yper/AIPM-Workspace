import {readNewsSources} from '../services/news/sources.ts';import {NewsService} from '../services/news/service.ts';import {RawStore} from '../services/raw/store.ts';import {mkdtemp} from 'node:fs/promises';import os from 'node:os';import assert from 'node:assert/strict';import {readFile,writeFile} from 'node:fs/promises';import path from 'node:path';const dir=path.resolve(process.argv[2]),events=(await readFile(path.join(dir,'events.jsonl'),'utf8')).trim().split('\n').map(JSON.parse);let requestCount=0;globalThis.fetch=async input=>{requestCount++;return replay(input)};const replay=async input=>{const url=String(input);if(url==='https://china.mintel.com/press-centre/')return new Response(await readFile('node_modules/.cache/news10-review/mintel-probe-64UpPY/directory.html'),{headers:{'content-type':'text/html'}});if(url==='https://china.mintel.com/press-centre/feed/')return new Response(await readFile('node_modules/.cache/news10-review/mintel-probe-64UpPY/feed.xml'),{headers:{'content-type':'application/rss+xml'}});if(url==='https://china.mintel.com/press-centre/flavour-innovation-trends/')return new Response(await readFile('node_modules/.cache/news10-review/mintel-probe-64UpPY/detail.html'),{headers:{'content-type':'text/html'}});const start=events.find(x=>x.event==='start'&&x.url===url);if(!start)return new Response('',{status:503});const h=events.find(x=>x.id===start.id&&x.event==='headers');if(!h)return new Response('',{status:503});if(h.status===301)return new Response('',{status:301,headers:{location:url.replace('https://kpmg.com/','https://assets.kpmg.com/')}});const b=await readFile(path.join(dir,start.id+'.bin'));return new Response(b,{status:h.status,headers:{'content-type':url.includes('.pdf')?'application/pdf':'text/html'}})};const root=await mkdtemp(path.join(os.tmpdir(),'news10-prod-')),clock=()=>new Date('2026-11-12T09:40:00Z'),rawStore=new RawStore(root);const svc=new NewsService({root,clock,readSources:readNewsSources,aiEnabled:false,providerFactory:async()=>{throw Error('model forbidden')},rawStore});await svc.ensure();let v;for(let i=0;i<200;i++){v=await svc.today();if(Object.values(v.edition.sections).every(x=>x.status!=='running'))break;await new Promise(r=>setTimeout(r,20))}const items=v.edition.sections.fmcg.items;for(const id of ['kpmg','mintel']){const item=items.find(x=>x.sourceId===id);assert.ok(item,id);const saved=await svc.saveRaw(v.date,'fmcg',item.id);const raw=await rawStore.get(saved.rawId);assert.equal(raw.body,item.excerpt);assert.equal((await svc.saveRaw(v.date,'fmcg',item.id)).created,false)}const before=requestCount;await svc.ensure();assert.equal(requestCount,before);console.log(JSON.stringify({root,cacheAdditional:requestCount-before,items:items.map(({sourceId,publishedAt,research})=>({sourceId,publishedAt,research})),rawVerified:true,models:0}));
